# ---------------------------------------------------------------------------
# AI model
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Groq, DeepSeek,
# Together, vLLM, Ollama, LM Studio, llama.cpp, or your own gateway.
#
#   openai-compatible  POST {AI_BASE_URL}/chat/completions   (default)
#   anthropic          POST {AI_BASE_URL}/messages
AI_PROVIDER=openai-compatible

# Include the version path. Defaults: https://api.openai.com/v1 for
# openai-compatible, https://api.anthropic.com/v1 for anthropic.
AI_BASE_URL=https://api.openai.com/v1

# Leave empty for local runtimes that do not check it (Ollama, LM Studio).
# When empty, no Authorization header is sent at all — some local servers
# reject an empty bearer token.
AI_API_KEY=

# Required. No default: guessing a model name on your behalf would be worse
# than failing on startup.
AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Per-role overrides (optional)
# ---------------------------------------------------------------------------
# Four roles, each falling back to AI_MODEL. Point the drafter at your best
# model and the utility work at a cheap one — that is most of the cost saving.
#
#   drafter     writes the reply             temperature 0.7  max_tokens 4000
#   critic      reviews it against the rules temperature 0.2  max_tokens 2000
#   translator  renders it in another language temperature 0  max_tokens 4000
#   utility     classification, summarising  temperature 0.2  max_tokens 2000
#
# AI_MODEL_DRAFTER=
# AI_MODEL_CRITIC=
# AI_MODEL_TRANSLATOR=
# AI_MODEL_UTILITY=
#
# AI_TEMPERATURE_DRAFTER=
# AI_MAX_TOKENS_DRAFTER=

# Per-request timeout. The default is 15 minutes: a self-hosted model on
# modest hardware genuinely takes minutes on a long thread, and a premature
# timeout is indistinguishable from a bug.
AI_TIMEOUT_MS=900000

# Retries on transient failures only (429, 5xx, network, empty completion).
# A 400 is never retried — that means our request is wrong.
AI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Currently: imap-smtp (works with any mailbox). Hosted APIs are planned.
MAIL_PROVIDER=imap-smtp

# The common case needs exactly these four.
MAIL_USER=support@yourcompany.com
MAIL_PASSWORD=
IMAP_HOST=imap.yourcompany.com
SMTP_HOST=smtp.yourcompany.com

# The address replies come from. Defaults to MAIL_USER. A display name here
# is what your customers see, so it is worth setting.
# MAIL_FROM=Acme Support <support@yourcompany.com>

# Defaults: 993 with implicit TLS. Port 587 automatically switches to
# STARTTLS (SMTP_SECURE=false) — set SMTP_SECURE explicitly to override.
# IMAP_PORT=993
# IMAP_SECURE=true
# SMTP_PORT=465
# SMTP_SECURE=true

# Mailbox names. INBOX by default; the Sent mailbox is discovered from the
# server's \Sent special-use flag, which beats guessing between "Sent",
# "Sent Items" and "[Gmail]/Sent Mail".
# IMAP_INBOX=INBOX
# IMAP_SENT_MAILBOX=

# Separate SMTP credentials, for relays such as SES or Postmark.
# Both default to MAIL_USER / MAIL_PASSWORD.
# SMTP_USER=
# SMTP_PASSWORD=
