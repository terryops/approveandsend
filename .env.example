# ---------------------------------------------------------------------------
# AI model
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, Groq, DeepSeek,
# Together, vLLM, Ollama, LM Studio, llama.cpp, or your own gateway.
#
#   openai-compatible  POST {AI_BASE_URL}/chat/completions   (default)
#   anthropic          POST {AI_BASE_URL}/messages
AI_PROVIDER=openai-compatible

# Include the version path. Defaults: https://api.openai.com/v1 for
# openai-compatible, https://api.anthropic.com/v1 for anthropic.
AI_BASE_URL=https://api.openai.com/v1

# Leave empty for local runtimes that do not check it (Ollama, LM Studio).
# When empty, no Authorization header is sent at all — some local servers
# reject an empty bearer token.
AI_API_KEY=

# Required. No default: guessing a model name on your behalf would be worse
# than failing on startup.
AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Per-role overrides (optional)
# ---------------------------------------------------------------------------
# Four roles, each falling back to AI_MODEL. Point the drafter at your best
# model and the utility and translator work at a cheap one — that is most of
# the cost saving. The translator only runs if you set a review language; see
# docs/review-language.md.
#
#   drafter     writes the reply             temperature 0.7  max_tokens 4000
#   critic      reviews it against the rules temperature 0.2  max_tokens 2000
#   translator  renders it for the reviewer   temperature 0    max_tokens 4000
#   utility     classification, summarising  temperature 0.2  max_tokens 2000
#
# AI_MODEL_DRAFTER=
# AI_MODEL_CRITIC=
# AI_MODEL_TRANSLATOR=
# AI_MODEL_UTILITY=
#
# AI_TEMPERATURE_DRAFTER=
# AI_MAX_TOKENS_DRAFTER=

# Per-request timeout. The default is 15 minutes: a self-hosted model on
# modest hardware genuinely takes minutes on a long thread, and a premature
# timeout is indistinguishable from a bug.
AI_TIMEOUT_MS=900000

# Retries on transient failures only (429, 5xx, network, empty completion).
# A 400 is never retried — that means our request is wrong.
AI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
#   imap-smtp  any mailbox, including self-hosted (default)
#   gmail      Gmail or Google Workspace, via the Gmail API
MAIL_PROVIDER=imap-smtp

# The common case needs exactly these four.
MAIL_USER=support@yourcompany.com
MAIL_PASSWORD=
IMAP_HOST=imap.yourcompany.com
SMTP_HOST=smtp.yourcompany.com

# The address replies come from. Defaults to MAIL_USER. A display name here
# is what your customers see, so it is worth setting.
# MAIL_FROM=Acme Support <support@yourcompany.com>

# Defaults: 993 with implicit TLS. Port 587 automatically switches to
# STARTTLS (SMTP_SECURE=false) — set SMTP_SECURE explicitly to override.
# IMAP_PORT=993
# IMAP_SECURE=true
# SMTP_PORT=465
# SMTP_SECURE=true

# Mailbox names. INBOX by default; the Sent mailbox is discovered from the
# server's \Sent special-use flag, which beats guessing between "Sent",
# "Sent Items" and "[Gmail]/Sent Mail".
# IMAP_INBOX=INBOX
# IMAP_SENT_MAILBOX=

# Separate SMTP credentials, for relays such as SES or Postmark.
# Both default to MAIL_USER / MAIL_PASSWORD.
# SMTP_USER=
# SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Gmail / Google Workspace  (MAIL_PROVIDER=gmail)
# ---------------------------------------------------------------------------
# Gmail also speaks IMAP, so MAIL_PROVIDER=imap-smtp with an app password
# still works. The API is worth the extra setup for two reasons: real threads
# (one request instead of reconstructing from headers over a bounded window),
# and no app-password, which Workspace admins increasingly disable.
#
# Pick ONE of the two blocks below. Which one you pasted is inferred from the
# variables, so there is no mode switch to keep in sync.

# --- One mailbox, consented by its owner. Personal Gmail or a single
# --- Workspace user. Start here.
#
# In Google Cloud console: create an OAuth client (type: Desktop app), then do
# the consent flow once with scopes gmail.modify and gmail.send and keep the
# refresh token. Note that a test-mode OAuth app expires refresh tokens after
# seven days — publish the app, or you will be re-consenting every week.
# MAIL_USER=support@yourcompany.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# --- Workspace domain-wide delegation. No per-user consent and no token to
# --- rotate, but the service account can read any mailbox in the domain, so
# --- only use it if an admin has deliberately set it up.
#
# In the Admin console, under Security > API controls > Domain-wide delegation,
# authorise the service account's client ID for exactly:
#   https://www.googleapis.com/auth/gmail.modify,
#   https://www.googleapis.com/auth/gmail.send
# GOOGLE_CLIENT_EMAIL=bot@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_IMPERSONATE_USER=support@yourcompany.com

# MAIL_FROM works the same as above and defaults to the mailbox.

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# One SQLite file. Migrations run automatically on open.
# DATABASE_PATH=data/aas.db

# ---------------------------------------------------------------------------
# The web UI
# ---------------------------------------------------------------------------
# One password, no accounts. Leaving this unset disables the login wall
# entirely and every page says so in red — fine on loopback, not on a VPS.
# ADMIN_PASSWORD=

# Signing key for the session cookie. Derived from ADMIN_PASSWORD when unset,
# which means changing the password signs everyone out. Set it explicitly if
# you would rather it did not.
# SESSION_SECRET=

# Bearer token for POST /api/sync, /api/worker and /api/consolidate, so cron
# can drive the system without holding the admin password. Falls back to the
# session cookie.
# CRON_TOKEN=

# The name in the header, if you would rather it said something else.
# APP_NAME="Approve & Send"

# The language of the interface itself. One of: en, zh-CN, ja, es, fr, de.
# A third language, unrelated to the two in aas.config.json — replyLanguage is
# what the customer gets, reviewLanguage is what the reviewer reads in the
# email panels, and this is what the buttons around them say.
# AAS_LANGUAGE=en

# Whether the session cookie is marked Secure. Left unset it follows the
# scheme the browser used, which is almost always what you want: HTTPS gets a
# Secure cookie, a plain-http LAN or Tailscale address gets one it can store.
# Set it to true only if you terminate TLS in front of this without setting
# X-Forwarded-Proto.
# COOKIE_SECURE=true
