# ---------------------------------------------------------------------------
# AI model
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, DeepSeek, Qwen, Moonshot,
# Zhipu, SiliconFlow, OpenRouter, Groq, Together, vLLM, Ollama, LM Studio,
# llama.cpp, or your own gateway.
#
#   openai-compatible  POST {AI_BASE_URL}/chat/completions   (default)
#   anthropic          POST {AI_BASE_URL}/messages
#   cli                a local `claude` or `codex`, see below
#
# The Settings screen offers those services by name and writes both lines for
# you; these two are what its menu comes out as.
AI_PROVIDER=openai-compatible

# Include the version path. Defaults: https://api.openai.com/v1 for
# openai-compatible, https://api.anthropic.com/v1 for anthropic.
AI_BASE_URL=https://api.openai.com/v1

# Leave empty for local runtimes that do not check it (Ollama, LM Studio).
# When empty, no Authorization header is sent at all — some local servers
# reject an empty bearer token.
AI_API_KEY=

# Required. No default: guessing a model name on your behalf would be worse
# than failing on startup. The Settings screen fills its own box in with a
# current name per provider, which is a suggestion in an editable field rather
# than a default here.
AI_MODEL=gpt-5.6-sol

# ---------------------------------------------------------------------------
# Spending a subscription instead of an API key  (AI_PROVIDER=cli)
# ---------------------------------------------------------------------------
# Claude Pro/Max and ChatGPT Plus are seats in an application, not credits on a
# platform: there is no endpoint to point AI_BASE_URL at and no key to put in
# AI_API_KEY. What there is, in both cases, is a first-party command-line agent
# that authenticates against the seat and will answer a prompt. This mode runs
# it as a subprocess.
#
# The Settings screen finds these on its own and offers a button, which is the
# easier route. These lines are what that button writes.
#
#   claude   Claude Pro or Max, via Claude Code.  `claude auth login`
#   codex    ChatGPT Plus or Pro, via Codex.      `codex login`
#
# AI_PROVIDER=cli
# AI_CLI=claude
# AI_MODEL=opus
#
# Claude takes an alias for the latest of a family — `opus`, `sonnet` — as well
# as a full model id; Codex takes a model id such as `gpt-5.6-sol`. The button
# writes the alias, because it is the one name that does not go stale.
#
# `AI_MODEL=default` is still understood and means "whichever model the CLI is
# already configured to use", chosen in the tool itself. It is the honest answer
# on a machine where somebody has already made that choice, and the reason it is
# no longer what the button writes is that a settings screen reading "drafting
# with default" answers the question with a word rather than a model.
#
# The binary is looked up on this process's PATH. A service manager typically
# starts the app with a much shorter PATH than your shell has, so a CLI that
# works when you type it can still be "not found" here. That is what this is:
# AI_CLI_BIN=/home/aas/.local/bin/claude
#
# What it costs, all of which the Settings screen also says:
#
#   - AI_TEMPERATURE_* and AI_MAX_TOKENS_* stop doing anything. Neither CLI
#     accepts them, so the per-role tuning below has no effect in this mode.
#   - Every call spawns a process and re-sends the agent's own preamble ahead
#     of ours — on the order of 15k tokens before the prompt.
#   - The limit is a rolling window rather than a bill. A busy morning or a
#     /backfill run can exhaust it for hours, and no retry shortens that, so a
#     refusal here is never retried.
#   - Both are agents that can read files and run commands, and drafting hands
#     them mail from strangers. They are run with their tools denied, in an
#     empty directory, with none of this server's environment — no mailbox
#     password, no Stripe key. See src/lib/ai/providers/cli.ts.
#   - Both subscriptions are individual seats. Using one to answer your own
#     mail is what it is for; using one to serve a team's shared inbox is not,
#     and that is a billing question rather than a technical one.

# ---------------------------------------------------------------------------
# Per-role overrides (optional)
# ---------------------------------------------------------------------------
# Four roles, each falling back to AI_MODEL. Point the drafter at your best
# model and the utility and translator work at a cheap one — that is most of
# the cost saving. The translator only runs if you set a review language; see
# docs/review-language.md.
#
#   drafter     writes the reply             temperature 0.7  max_tokens 4000
#   critic      reviews it against the rules temperature 0.2  max_tokens 2000
#   translator  renders it for the reviewer   temperature 0    max_tokens 4000
#   utility     classification, summarising  temperature 0.2  max_tokens 2000
#
# AI_MODEL_DRAFTER=
# AI_MODEL_CRITIC=
# AI_MODEL_TRANSLATOR=
# AI_MODEL_UTILITY=
#
# AI_TEMPERATURE_DRAFTER=
# AI_MAX_TOKENS_DRAFTER=

# Per-request timeout. The default is 15 minutes: a self-hosted model on
# modest hardware genuinely takes minutes on a long thread, and a premature
# timeout is indistinguishable from a bug.
AI_TIMEOUT_MS=900000

# Retries on transient failures only (429, 5xx, network, empty completion).
# A 400 is never retried — that means our request is wrong.
AI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
#   imap-smtp  any mailbox, including self-hosted (default)
#   gmail      Gmail or Google Workspace, via the Gmail API
#   zoho       Zoho Mail, via its REST API
MAIL_PROVIDER=imap-smtp

# The common case needs exactly these four.
MAIL_USER=support@yourcompany.com
MAIL_PASSWORD=
IMAP_HOST=imap.yourcompany.com
SMTP_HOST=smtp.yourcompany.com

# The address replies come from. Defaults to MAIL_USER. A display name here
# is what your customers see, so it is worth setting.
# MAIL_FROM=Acme Support <support@yourcompany.com>

# Replies go out as text and HTML, the HTML derived from the same text so the
# two cannot say different things. Set false for a text-only house style.
# MAIL_REPLY_HTML=true

# Pictures an incoming letter keeps on somebody else's server. On: this server
# fetches each one and serves it to the reviewer from your own origin, so the
# sender learns that something pulled an image and nothing about the person who
# opened their mail. Off: nothing is fetched and the letter reports how many it
# asked for. Only addresses that appeared in a letter are fetchable — they are
# signed — and private ranges are refused after the name resolves.
# MAIL_REMOTE_IMAGES=true

# Defaults: 993 with implicit TLS. Port 587 automatically switches to
# STARTTLS (SMTP_SECURE=false) — set SMTP_SECURE explicitly to override.
# IMAP_PORT=993
# IMAP_SECURE=true
# SMTP_PORT=465
# SMTP_SECURE=true

# Mailbox names. INBOX by default; the Sent mailbox is discovered from the
# server's \Sent special-use flag, which beats guessing between "Sent",
# "Sent Items" and "[Gmail]/Sent Mail".
# IMAP_INBOX=INBOX
# IMAP_SENT_MAILBOX=

# Separate SMTP credentials, for relays such as SES or Postmark.
# Both default to MAIL_USER / MAIL_PASSWORD.
# SMTP_USER=
# SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Gmail / Google Workspace  (MAIL_PROVIDER=gmail)
# ---------------------------------------------------------------------------
# Gmail also speaks IMAP, so MAIL_PROVIDER=imap-smtp with an app password
# still works. The API is worth the extra setup for two reasons: real threads
# (one request instead of reconstructing from headers over a bounded window),
# and no app-password, which Workspace admins increasingly disable.
#
# Pick ONE of the two blocks below. Which one you pasted is inferred from the
# variables, so there is no mode switch to keep in sync.

# --- One mailbox, consented by its owner. Personal Gmail or a single
# --- Workspace user. Start here.
#
# In Google Cloud console: create an OAuth client (type: Desktop app), then do
# the consent flow once with scopes gmail.modify and gmail.send and keep the
# refresh token. Note that a test-mode OAuth app expires refresh tokens after
# seven days — publish the app, or you will be re-consenting every week.
# MAIL_USER=support@yourcompany.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# --- Workspace domain-wide delegation. No per-user consent and no token to
# --- rotate, but the service account can read any mailbox in the domain, so
# --- only use it if an admin has deliberately set it up.
#
# In the Admin console, under Security > API controls > Domain-wide delegation,
# authorise the service account's client ID for exactly:
#   https://www.googleapis.com/auth/gmail.modify,
#   https://www.googleapis.com/auth/gmail.send
# GOOGLE_CLIENT_EMAIL=bot@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_IMPERSONATE_USER=support@yourcompany.com

# MAIL_FROM works the same as above and defaults to the mailbox.

# ---------------------------------------------------------------------------
# Zoho Mail  (MAIL_PROVIDER=zoho)
# ---------------------------------------------------------------------------
# Zoho also speaks IMAP, but only after an admin turns IMAP on AND issues an
# application-specific password. Both are off by default and both fail as
# "Invalid credentials", so the API is the easier path even though it needs an
# OAuth client. See docs/mailboxes.md.
#
# From https://api-console.zoho.com — a Self Client, consented once for the
# scopes in src/lib/mail/providers/zoho/auth.ts. The refresh token does not
# rotate and is never written back to disk.
# MAIL_USER=support@yourcompany.com
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=

# Which Zoho data centre the account lives in: com, eu, in, com.au, jp, ca.
# They are separate installations that share no credentials, so a token from
# the wrong one is rejected exactly like a bad secret. Defaults to com.
# ZOHO_REGION=com

# Discovered from MAIL_USER. Set it only if this login owns several mailboxes
# and the wrong one is picked.
# ZOHO_ACCOUNT_ID=

# Folder display names, for a mailbox that has renamed or localised them.
# ZOHO_INBOX_FOLDER=Inbox
# ZOHO_SENT_FOLDER=Sent

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# One SQLite file. Migrations run automatically on open.
# DATABASE_PATH=data/aas.db

# ---------------------------------------------------------------------------
# The web UI
# ---------------------------------------------------------------------------
# One password, no accounts. Leaving this unset disables the login wall
# entirely and every page says so in red — fine on loopback, not on a VPS.
# ADMIN_PASSWORD=

# Signing key for the session cookie. Left unset, a random one is generated on
# first use and kept in the database, which is what you want. Set it to sign
# every session out at once, or to share sessions across two processes.
# It is deliberately no longer derived from ADMIN_PASSWORD: that made a stolen
# cookie into an offline password cracker. The cost is that changing the
# password does not log anyone out — change this instead.
# SESSION_SECRET=

# Bearer token for POST /api/sync, /api/worker, /api/sweep, /api/consolidate,
# the context write and the legacy import, so cron can drive the system without
# holding the admin password. Set it and it is required: these endpoints stop
# accepting a browser session entirely.
# CRON_TOKEN=

# Lets the endpoints above accept a logged-in browser session when CRON_TOKEN
# is unset — for driving them from an open tab rather than a scheduler. Off by
# default, because without it those endpoints are open on any install that has
# no password and no operators. Same-origin is required either way.
# AAS_MACHINE_SESSION=1

# Directory the legacy importer is allowed to read from. Unset, POST
# /api/import/legacy returns 403 and reads nothing — the path in its body would
# otherwise open any file on the host as SQLite. Point it at the old install's
# data directory for the one run, then take it back out.
# AAS_IMPORT_ROOT=/srv/old/data

# The name in the header, if you would rather it said something else.
# APP_NAME="Approve & Send"

# The language of the interface itself. One of: en, zh-CN, ja, es, fr, de.
# A third language, unrelated to the two in aas.config.json — replyLanguage is
# what the customer gets, reviewLanguage is what the reviewer reads in the
# email panels, and this is what the buttons around them say.
# AAS_LANGUAGE=en

# Whether the session cookie is marked Secure. Left unset it follows the
# scheme the browser used, which is almost always what you want: HTTPS gets a
# Secure cookie, a plain-http LAN or Tailscale address gets one it can store.
# Set it to true only if you terminate TLS in front of this without setting
# X-Forwarded-Proto.
# COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Billing (Stripe) — optional
# ---------------------------------------------------------------------------
# Turns on the billing context source, the /billing screens and the catalogue.
# Unset, none of it is registered, called or shown, and drafts know nothing
# about what anybody pays.
#
# Make it a *restricted* key (rk_…) with **read** on customers, subscriptions
# and charges — nothing here writes, so nothing here needs write. Add read on
# products and prices if you want the catalogue too; the customer lookups do
# not need it and will not complain about its absence.
#
# The Settings screen writes this for you and has a Test button that names any
# permission the key is missing, which is worth more than a key that merely
# authenticates: a key with customers but not charges finds the customer and
# then shows an empty payment list, which reads as "they never paid us".
# STRIPE_API_KEY=rk_live_...

# The switch, which is not the key. `0`, `false`, `off` or `no` stops every
# billing lookup — on the review screen and in the drafting prompt — while
# leaving the credential where it is. Unset means on, so an install that set
# only STRIPE_API_KEY behaves exactly as it did before this existed.
# STRIPE_ENABLED=0
