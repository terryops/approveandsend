{
  "organization": "SubEasy.ai",
  "product": "an AI transcription, subtitle, translation and dubbing platform for audio and video, run by Bikgo Network Ltd of Hong Kong",
  "voice": "Warm, direct and specific. Answer the question first, then explain. Never open with an apology paragraph, never pad, and never promise anything the rulebook does not already allow.",
  "facts": [
    "Free tier: 3 transcriptions per day, each under 30 minutes. The first one each day goes through the fast lane; the second and third are slower.",
    "Paid plans are Pro ($9.90/mo, $89/yr), Pro Plus ($15/mo, $129/yr), Unlimited ($39/mo, $348/yr) and Unlimited Plus ($59/mo, $539/yr) in USD, also billed in TWD, HKD and JPY.",
    "Pay-as-you-go credits are $5 per 100 credits (HK$39 per 100 credits).",
    "There is a 50% education discount for anyone with an EDU address, and a 30% government discount.",
    "A refund that has been issued takes 5-10 business days to appear, depending on the customer's bank.",
    "Monthly plan credits roll over once: unused credits pause at the end of the period and reactivate for 30 days after the customer renews, so within a continuous subscription a credit is usable for at most 60 days. Credits reactivate only once.",
    "Deleting the account or uninstalling the app does not cancel the subscription; cancellation happens in the billing page.",
    "Support is staffed 10:00-19:00 UTC+8, so a reply may arrive the next working day.",
    "Pro Plus is $15/mo or $129/yr; the four plans in local currency are Pro HK$78 / NT$318 / ¥1,400 a month, Pro Plus HK$118 / NT$480 / ¥2,400, Unlimited HK$298 / NT$1,238 / ¥5,700, Unlimited Plus HK$459 / NT$1,899 / ¥9,000.",
    "Voice cloning is bought separately: $2.99 for one voice, $5.99 for three, $12.99 for five. AppSumo holders can buy 300 API credits for $9.",
    "Transcription runs on Whisper with GPT on top, and speaker separation on NVIDIA NeMo. Over 100 languages are supported for both transcription and translation.",
    "There are two transcription models: the standard one, used by default, and an advanced one that is still experimental but more accurate. Someone unhappy with recognition accuracy should be asked to re-run the file on the advanced model before anything else is investigated.",
    "There are three translation modes, in ascending quality: Microsoft translation, AI translation, and AI Plus translation, which is close to human quality. Someone unhappy with a translation should be pointed at AI Plus.",
    "Timings can be fixed by the customer: the waveform editor has a Calibrate control at its top right that re-aligns the timeline. That is the first answer to 'the subtitles are out of sync', not a re-upload.",
    "Clear+ is the built-in noise reduction, and helps most with noisy or low-quality recordings. Subtitle Reflow is the context-aware line breaking that splits subtitles on meaning rather than on character count.",
    "SubEasy is on AppSumo with a 4.8 out of 5 rating. AppSumo licences are lifetime deals, not subscriptions.",
    "tools.video is our free companion site: browser-only video tools, nothing uploaded to a server, files up to 50GB, no account needed, free with no paid tier. It is a reasonable answer for simple format or trimming jobs that do not need SubEasy at all.",
    "Bikgo Network Ltd was founded in Hong Kong in 2019 and also runs tools.video."
  ],
  "signature": "SubEasy Support Team",
  "replyLanguage": "match",
  "reviewLanguage": "zh-CN",
  "language": "zh-CN",
  "topics": [
    {
      "slug": "billing-refund-cancel",
      "label": "退款与取消",
      "description": "Wants money back, disputes a charge, was billed after cancelling, is cancelling, or has opened a chargeback."
    },
    {
      "slug": "billing-invoice-receipt",
      "label": "发票与收据",
      "description": "Wants an invoice, a receipt, a VAT or tax number on one, or a change to the billing details on a document already issued."
    },
    {
      "slug": "pricing-plans-credits",
      "label": "定价方案与点数",
      "description": "Asking before buying: what a plan costs, what it includes, how credits are counted and when they expire, education and government discounts, or a checkout that will not go through."
    },
    {
      "slug": "account-access",
      "label": "账号访问",
      "description": "Cannot sign in, lost the password, signed up with the wrong address, wants the email on the account changed, or wants the account deleted."
    },
    {
      "slug": "job-failure-and-performance",
      "label": "任务失败与性能",
      "description": "A job failed, stalled, produced nothing, took far too long, or the finished file has disappeared. About the run, not about how good the output was."
    },
    {
      "slug": "transcription-quality",
      "label": "转录质量",
      "description": "The transcript is wrong: misheard words, the wrong language detected, speakers merged or split, traditional versus simplified Chinese, dialect handled badly."
    },
    {
      "slug": "translation-and-dubbing",
      "label": "翻译与配音",
      "description": "The translation or the generated voice is the problem: wrong tone, wrong terminology, unnatural speech, voice or language not available."
    },
    {
      "slug": "subtitle-editing-and-export",
      "label": "字幕编辑与导出",
      "description": "Working with the subtitles themselves: line breaks and segmentation, timings, export formats, and getting the result into an editor."
    },
    {
      "slug": "feature-gap-and-ui-change",
      "label": "功能缺失与界面",
      "description": "Asking for something the product does not do, reporting that something they used to use has moved or gone, or unhappy with a redesign."
    },
    {
      "slug": "api-and-integration",
      "label": "API 与集成",
      "description": "Using the product from code or from another tool: API keys, endpoints, quotas, webhooks, automation."
    },
    {
      "slug": "enterprise-bd",
      "label": "企业合作",
      "description": "Buying at company scale: volume pricing, procurement, security review, invoicing terms, a contract or a pilot."
    },
    {
      "slug": "partnership-and-press",
      "label": "推广合作与媒体",
      "description": "Not a customer question: affiliate and reseller offers, press and interview requests, sponsorship, integration proposals, and cold sales pitches at us."
    },
    {
      "slug": "conversation-state",
      "label": "对话状态",
      "description": "The mail is about the conversation rather than the problem: thanks and goodbyes, dropping the matter, or promising to send something later."
    }
  ],
  "neverPromise": [
    "A date for a feature that has not shipped",
    "A refund amount or a discount the rulebook does not already allow",
    "Any change to a customer's billing, plan or credits — that has to be done by a person in the admin",
    "That a quality problem in transcription, translation or dubbing will be fixed by a particular time"
  ],
  "contextSources": [
    {
      "id": "subeasy",
      "label": "SubEasy account",
      "command": [
        "node",
        "/home/terryops/clawd/scripts/subeasy-lookup.js",
        "{email}"
      ],
      "timeoutMs": 90000,
      "requires": "found",
      "title": "SubEasy account",
      "href": "https://www.subeasy.ai/c8ff3d8b-10a4-4e41-b85f-b2b254ad194e/admin/users/userprofile/?q={email}",
      "fields": [
        {
          "label": "Plan",
          "path": "level",
          "map": {
            "0": "Free",
            "1": "Pro",
            "2": "Unlimited"
          }
        },
        {
          "label": "Credits",
          "path": "credits"
        },
        {
          "label": "AppSumo",
          "path": "isAppSumo"
        },
        {
          "label": "User",
          "path": "displayName"
        }
      ],
      "prompt": [
        "They registered on {createdAt} and are user {userId}.",
        "Their account level is {level} — 0 is Free, 1 is Pro, 2 is Unlimited — so do not describe features their level cannot reach.",
        "They have {credits} credits left; the next batch expires {creditNextExpiry}.",
        "{?isAppSumo}They hold an AppSumo lifetime licence, so never quote them a subscription price or a renewal date, and never suggest they upgrade a plan."
      ]
    },
    {
      "id": "subeasy-usage",
      "label": "SubEasy usage",
      "command": [
        "node",
        "/home/terryops/clawd/scripts/collect-user-usage.js",
        "{email}",
        "--json"
      ],
      "timeoutMs": 90000,
      "requires": "activeDays",
      "title": "Usage",
      "fields": [
        {
          "label": "Minutes",
          "path": "totalMinutes"
        },
        {
          "label": "Active days",
          "path": "activeDays"
        },
        {
          "label": "Success rate",
          "path": "successRate",
          "suffix": "%"
        },
        {
          "label": "Language",
          "path": "primaryLanguage"
        },
        {
          "label": "Last used",
          "path": "lastUsedAt"
        }
      ],
      "prompt": [
        "They have processed {totalMinutes} minutes of media over {activeDays} active days, most recently on {lastUsedAt}.",
        "Their work is mostly in {primaryLanguage}, so an example in that language will land better than an English one.",
        "Their jobs succeed {successRate}% of the time — treat a lower number as a real signal that something in their workflow is broken, not as user error."
      ]
    }
  ],
  "appName": "SubEasy客服工作台"
}
